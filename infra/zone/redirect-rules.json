{
  "description": "<domain> single redirects",
  "rules": [
    {
      "description": "<worker>: always HTTPS (independent of the zone-wide Always Use HTTPS setting)",
      "expression": "(http.host eq \"<domain>\" and not ssl)",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "status_code": 301,
          "target_url": {
            "expression": "concat(\"https://<domain>\", http.request.uri.path)"
          },
          "preserve_query_string": true
        }
      }
    }
  ]
}