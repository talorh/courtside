{
	"compilerOptions": {
		"target": "es2024",
		"lib": [
			"es2024"
		],
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": [],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": [
		"src",
		"cloudflare.config.ts",
		".cloudflare/types",
		"maintenance",
		"join"
	],
	"exclude": [
		"maintenance/cloudflare.config.ts",
		"maintenance/vite.config.ts",
		"maintenance/node_modules",
		"join/cloudflare.config.ts",
		"join/vite.config.ts",
		"join/node_modules"
	]
}
