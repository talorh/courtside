# Headers for the static files in public/ (pages set their own in src/app/respond.ts). A file picks up every rule
# that matches it.

# Every file, as every page: never indexed, and never read as anything but its own type. The site's sign-in keeps them private.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff

# Cache rules. Without these, browsers re-check every file on every page. CSS and scripts are left alone so a deploy
# shows straight away. Fonts never change: a new version gets a new file name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images rarely change. Replacing one in place takes up to a day to reach phones that have it (or rename it).
/*.png
  Cache-Control: public, max-age=86400
/*.webp
  Cache-Control: public, max-age=86400
/*.jpg
  Cache-Control: public, max-age=86400
/*.jpeg
  Cache-Control: public, max-age=86400
/*.ico
  Cache-Control: public, max-age=86400
