{
	"name": "courtside",
	"license": "Apache-2.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=26.12.0"
	},
	"scripts": {
		"dev": "CLOUDFLARE_AUTH_USE_KEYRING=false cf dev",
		"skills": "export DISABLE_TELEMETRY=1; skills install -a claude-code -a opencode -a windsurf -a roo -a kiro-cli -a goose -a junie -a augment -a continue && skills update -p -y && skills list",
		"dev:db": "node scripts/dev-db.mjs",
		"dev:seed": "node scripts/dev-seed.mjs",
		"build": "cf build",
		"deploy": "echo \"Deploy with: npm run release (it runs every check first)\" && exit 1",
		"typecheck": "cf workers types && tsc && tsc -p tests",
		"test": "vitest run",
		"check": "npm run typecheck && npm test && npm run loc && npm run rules",
		"loc": "node scripts/check-loc.mjs",
		"rules": "node scripts/check-rules.mjs",
		"e2e": "node scripts/e2e.mjs",
		"release": "node --no-warnings scripts/release.mjs",
		"docs": "node --no-warnings scripts/export-docs.mjs",
		"admin": "node scripts/admin.mjs",
		"club": "node scripts/club.mjs",
		"deploy:builds": "node --no-warnings scripts/deploy-from-builds.mjs",
		"restore-d1": "node --no-warnings scripts/restore-d1.mjs",
		"maintenance": "node --no-warnings scripts/maintenance.mjs",
		"staging": "node scripts/staging.mjs",
		"logs": "node --no-warnings scripts/logs.mjs",
		"join": "node scripts/join.mjs",
		"terraform": "node --no-warnings scripts/terraform.mjs"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "2.0.0-rc.1",
		"@types/node": "^26.6.5",
		"cf": "1.0.0-rc.1",
		"playwright": "1.56.1",
		"skills": "^1.9.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.4"
	},
	"dependencies": {
		"@cloudflare/containers": "^0.3.7",
		"aws4fetch": "^1.0.20",
		"jose": "^6.2.12",
		"zod": "^4.6.7"
	},
	"allowScripts": {
		"workerd": true
	}
}
